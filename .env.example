NODE_ENV=production
G0DLOG_IMAGE=ghcr.io/g0dn/g0dlog:latest
PUBLIC_SITE_URL=https://your-public-domain.example
BLOG_DATA_DIR=/DATA/G0dLog/data
BLOG_MEDIA_DIR=/DATA/G0dLog/media
BLOG_BACKUP_DIR=/DATA/G0dLog/backups
BLOG_PORT=3000
# Private IPv4 LAN acceptance only: set URL to http://<NAS-IP>:3000 and opt in.
ALLOW_INSECURE_LAN=0
# Optional operational SMTP configuration; never commit real credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
